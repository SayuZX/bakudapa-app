<?xml version="1.0" encoding="utf-8"?>
<!--
   Tolak backup otomatis Google ke Drive untuk data sensitif aplikasi.
   File aplikasi BAKUDAPA MOBILE mengandung token dan data biometrik metadata.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
